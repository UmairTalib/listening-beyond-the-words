# Editor settings for every file type. See https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.py]
max_line_length = 100

[*.{yml,yaml,json,md,sh,sbatch,tex,bib}]
indent_size = 2

[Makefile]
indent_style = tab
